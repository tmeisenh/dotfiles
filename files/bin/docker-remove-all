#!/usr/bin/env bash
#
# Removes all stopped containers, all unused images, unused networks,
# anonymous volumes, and the build cache. Running containers (and what they
# use) are left alone; run docker-stop-all first to clear everything.

docker system prune --all --volumes --force

# Docker Desktop on macOS keeps everything in one disk image
data_dir=~/Library/Containers/com.docker.docker/Data
if [[ -d $data_dir ]]; then
  dockerSize=$(du -sh "$data_dir" | cut -f 1)
  echo "Consider resetting Docker if this value is significantly over 1.3GB: ${dockerSize}"
fi
